# Frontend config. The frontend holds NO secrets — no DB credentials, no JWT
# secret. It only needs to know where the Spring Boot backend is.
#
# Leave EMPTY for local development: vite.config.js proxies /api to
# http://localhost:8081, so the browser makes same-origin requests and CORS
# never applies.
#
# Set an absolute URL for a deployed build. That origin must then appear in the
# backend's CorsConfig allowlist.
#   VITE_API_URL=http://localhost:8081
VITE_API_URL=
