# ---------------------------------------------------------------------------
# food-hub-backend — environment configuration
#
# Copy to .env and fill in the values:
#     cp .env.example .env
#
# .env is read at startup by spring-dotenv, so `mvn spring-boot:run` works in a
# plain terminal with nothing exported. Real environment variables still take
# precedence over .env, so CI and deployments can keep using those.
#
# .env is gitignored. NEVER commit a file containing the real password.
# ---------------------------------------------------------------------------

# --- Database: Supabase (the default target) -------------------------------
# All three are required — application.properties defines no fallbacks, so the
# app refuses to start rather than silently connecting to the wrong database.
DB_URL=jdbc:postgresql://db.zbiglpyyirmmauowesof.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
# Supabase dashboard -> Project Settings -> Database -> Database password
DB_PASSWORD=

# --- Database: local backup (only if you want to run against local) --------
# Note: starting the app against this database WRITES to it (the seeder and
# repairFoodRows run on every boot), so it stops being a pristine backup.
# DB_URL=jdbc:postgresql://localhost:5432/foodhub
# DB_USERNAME=postgres
# DB_PASSWORD=<your local postgres password>

# --- Database: Supabase pooler (only needed on an IPv4-only network) -------
# The direct db.<ref>.supabase.co host is IPv6-only. If your network has no
# IPv6 route, use the pooler instead (region shown in the Supabase dashboard):
# DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres
# DB_USERNAME=postgres.zbiglpyyirmmauowesof
# and uncomment spring.datasource.hikari.data-source-properties.prepareThreshold=0

# --- JWT -------------------------------------------------------------------
# Optional locally (application.properties has a dev-only fallback). Must be at
# least 32 characters for HS256. Set a real random value in any non-local
# environment.
# JWT_SECRET=
# JWT_EXPIRATION_MS=86400000
